<!doctype html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href= "/static/styles.css" rel="stylesheet" >
  </head>
 <body class="bg-gray-50">
  {% include "components/navbar.html.jinja" %}


  <main class="max-w-6xl mx-auto px-6 py-10">


    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">


      
      <div class="flex justify-center">
        <img 
          class="max-h-[450px] object-contain border-2 border-gray-300 rounded-lg shadow"
          src="{{ product['Image'] }}"
          alt="{{ product['Name'] }}"
        >
      </div>


      
      <div class="space-y-4">
        <h1 class="text-3xl font-bold">{{ product["Name"] }}


        </h1>
      {% if avg_rating %}
    <p>Average Rating: {{ avg_rating | round(1) }}/5 ({{ review_count }} reviews)</p>
    {% else %}
    <p>No ratings yet</p>
    {% endif %}
        <p class="text-2xl font-semibold ">
          ${{ product["Price"] }}
        </p>


        <p class="text-gray-600">
          <span class="font-semibold">Size:</span> {{ product["Size"] }}
        </p>


        <p class="text-gray-700">
          <span class="font-semibold">Description:</span><br>
          {{ product["Description"] }}
        </p>


        <form method="post" action="/product/{{ product['ID'] }}/add_to_cart" class="flex items-center gap-4 mt-6">
          <label class="font-medium">Qty:</label>
          <input 
            name="qty" 
            type="number" 
            value="1" 
            min="1" 
            max="10"
            class="w-20 border rounded px-2 py-1"
          >
          <button 
            type="submit"
            class="flex items-center gap-2 bg-blue-700 text-white px-6 py-2 rounded-lg hover:bg-blue-800 transition"
          >
            <i data-lucide="shopping-cart"></i>
            Add to Cart
          </button>
        </form>
      </div>
    </div>


    
    <div class="mt-14 border rounded-lg p-6 bg-white shadow-sm">
      <h2 class="text-xl font-semibold mb-4">Leave a Review</h2>


      <form method="post" action="/product/{{product['ID']}}/add_review" class="space-y-4">


        <div>
          <label class="block font-medium mb-2">Rating</label>
          <div class="flex gap-4">
            {% for i in range(1,6) %}
              <label class="flex items-center gap-1">
                <input type="radio" name="rating" value="{{ i }}">
                {{ i }}
              </label>
            {% endfor %}
          </div>
        </div>


        
        <div>
          <label class="block font-medium mb-1">Comments</label>
          <textarea 
            class="w-full border rounded p-2"
            name="comments"
            rows="3"
          ></textarea>
        </div>


        <button 
          type="submit"
          class="bg-sky-600 text-white px-6 py-2 rounded hover:bg-sky-700 transition"
        >
          Submit Review
        </button>
      </form>
    </div>


    <div class="mt-10">
      <h2 class="text-xl font-semibold mb-4">Customer Reviews</h2>


      <div class="space-y-4">
        {% for x in reviews %}
          <div class="border rounded p-4 bg-white shadow-sm">
          <p>{{x["Name"]}}</p>
            <div class="font-semibold">
              {{ x["Rating"] }}/5
            </div>
            <p class="text-gray-700">
              {{ x["Comments"] }}
            </p>
            {{ x['Timestamp'].strftime('%x') }}
          </div>
        {% else %}
          <p class="text-gray-500">No reviews yet.</p>
        {% endfor %}
      </div>
    </div>


  </main>
</body>

</html>
