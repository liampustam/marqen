<!doctype html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="/static/styles.css" rel="stylesheet">
  </head>

  <body class="bg-gray-50 min-h-screen flex flex-col">
    {% include "components/navbar.html.jinja" %}

    <main class="flex-grow flex items-center justify-center px-6 py-16">
      <div class="max-w-3xl w-full bg-white border rounded-lg shadow-sm p-10 text-center">
        
        <h1 class="text-6xl font-extrabold text-gray-800 mb-4">
          404
        </h1>

        <p class="text-2xl font-semibold text-gray-700 mb-2">
          Page Not Found
        </p>

        <p class="text-gray-600 mb-8">
          Oops — the page you’re looking for doesn't exist or may have been moved.
        </p>

        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a
            href="/"
            class="bg-blue-700 text-white px-6 py-3 rounded-lg hover:bg-blue-800 transition"
          >
            Go Home
          </a>

          <a
            href="/browse"
            class="border border-gray-300 text-gray-700 px-6 py-3 rounded-lg hover:bg-gray-100 transition"
          >
            Browse Products
          </a>
        </div>
        <div class="mt-10 text-gray-400 text-sm">
          If you think this is a mistake, please let us know.
        </div>
      </div>
    </main>
  </body>
</html>
